.DATA
WORD x0102030405060708
BUF d0
TEXT t'SimpleASM'
TAIL t' tests!'
.CODE
EXTRA DEF d99
START LI R0, d73
      LA R1, WORD
      LMU R2, WORD, d1
      LMU R3, WORD + d2, d2
      LMU R4, WORD, d8
      ST R4, BUF, d8
      LI R5, d254
      ST R5, BUF, d1
      LMU R6, BUF, d1
      LMS R7, BUF, d1
      LA R3, BUF
      LI R5, d4660
      ST R5, [R3 + d2], d2
      LMU R6, [R3 + d2], d2
      LI R5, d32768
      ST R5, BUF + d4, d2
      LMS R7, BUF + d4, d2
      LA R1, TEXT
      WRTE [R1]
      WRTE TAIL
      LA R1, WORD + d4
      LMU R0, [R1 - d2], d2
      LA R1, TAIL - d2
      LMU R0, [R1], d2
      LR R3, R0
      LI R1, d7
      EXIT
